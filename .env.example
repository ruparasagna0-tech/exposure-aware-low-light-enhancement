# This project needs NO secrets, API keys or tokens.
# Official weights are downloaded from public Hugging Face / GitHub URLs; Colab notebooks mount Google Drive interactively.
#
# The only environment variable read by the code (scripts/check_lol_loader.py, scripts/visualize_lol.py):
# path to the extracted LOL-v1 dataset (default: data/LOL/LOLdataset)
LOL_V1_ROOT=data/LOL/LOLdataset
